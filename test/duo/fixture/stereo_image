#!/bin/sh
# Usage: stereo_image MODEL VOICES V/OCT - plays a duo model (0 to 7) in the
# stereo layout, with the knobs at noon, V/OCT at V/OCT volts and one or two
# voices (the second one 7 semitones higher), for 20 seconds, and prints its
# stereo image (see plaits-analyze image).
{
  echo "wait 500ms"
  echo "tap both"
  ./taps left "$1"
  echo "knob harmonics 0.5"
  echo "knob timbre 0.5"
  echo "knob morph 0.5"
  echo "cv v_oct $3"
  if [ "$2" = 2 ]; then
    echo "cv level 0.583"
  fi
  echo "wait 500ms"
  echo "clear"
  echo "wait 20s"
} | plaits-sim -o stereo_image.wav
plaits-analyze image stereo_image.wav
